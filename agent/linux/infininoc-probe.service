[Unit]
Description=InfiniNOC Remote Distributed Probe Monitoring Daemon
After=network.target network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/infininoc-probe
ExecStart=/usr/bin/node /opt/infininoc-probe/infininoc-probe-agent.js --config=/opt/infininoc-probe/infininoc-probe-config.json
Restart=always
RestartSec=10
StandardOutput=append:/var/log/infininoc-probe.log
StandardError=append:/var/log/infininoc-probe.log
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
